# =====================================================
# TOP-K
# =====================================================

def test_top_k_drivers():

    drivers, trips, activities = create_test_data()

    service = AdvancedAnalyticsService(
        drivers,
        trips,
        activities
    )

    result = service.top_k_drivers_by_fare(1)

    assert len(result) == 1

    assert result[0]["driver"].driver_id == "D1"

    assert result[0]["total_fare"] == 1600


# =====================================================
# CONSECUTIVE TRIPS
# =====================================================

def test_consecutive_trip_analysis():

    drivers, trips, activities = create_test_data()

    service = AdvancedAnalyticsService(
        drivers,
        trips,
        activities
    )

    result = service.consecutive_trip_analysis()

    d1 = next(
        row
        for row in result
        if row["driver_id"] == "D1"
    )

    assert d1["total_completed_trips"] == 3

    assert d1["longest_consecutive_streak"] == 3


