# =====================================================
# CANCELLATION
# =====================================================

def test_cancellation_intelligence():

    drivers, trips, activities = create_test_data()

    service = AdvancedAnalyticsService(
        drivers,
        trips,
        activities
    )

    result = service.cancellation_intelligence()

    assert result["total_cancelled"] == 1

    assert result["overall_cancellation_rate"] == 20

    assert len(result["by_city"]) == 2

    assert len(result["by_driver"]) == 2

    assert len(result["by_reason"]) == 1

    assert result["by_reason"]["Driver cancelled"] == 1